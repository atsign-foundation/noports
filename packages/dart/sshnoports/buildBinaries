#!/bin/bash

echo Starting at $(date)
echo

names=()
pids=()
# Compiles bin/$1.dart to bin/$1 in the background.
compile() {
  echo "Compiling $1"
  dart compile exe --verbosity error "bin/$1.dart" -o "bin/$1" &
  names+=("$1")
  pids+=($!)
}

compile atsc
compile srv
compile demo/npa_always_deny
compile demo/npa_cli

failed=()
for i in "${!pids[@]}"; do
  wait "${pids[$i]}" || failed+=("${names[$i]}")
done
if [ "${#failed[@]}" -gt 0 ]; then
  echo "Failed to compile: ${failed[*]}"
  exit 1
fi

echo "Copying launchers"
find launchers -maxdepth 1 -type f -exec cp {} bin/ \;

echo
echo Finished at $(date)
