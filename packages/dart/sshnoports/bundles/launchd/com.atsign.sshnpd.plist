<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.atsign.sshnpd</string>
	<key>ProgramArguments</key>
    <array>
      <!-- Wrapped in a shell so we can access the environment -->
      <string>/bin/sh</string>
      <string>-c</string>
      <string>$(brew --prefix)/bin/sshnpd --config $HOME/Library/Application\ Support/NoPorts/sshnpd.yaml</string>
	</array>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
