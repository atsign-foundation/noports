#!/bin/sh
# Runs "atsc npt" with these arguments, using the atsc in the directory
# that holds this script once symbolic links to it are followed.
p=$0
case $p in
*/*) ;;
*)
  echo "$0: run $0 by its path, such as ./$0" >&2
  exit 127
  ;;
esac
n=0
while [ -L "$p" ]; do
  n=$((n + 1))
  if [ "$n" -gt 40 ]; then
    echo "$0: too many symbolic links" >&2
    exit 127
  fi
  if ! l=$(readlink -- "$p"); then
    echo "$0: cannot follow the symbolic link $p" >&2
    exit 127
  fi
  case $l in
  /*) p=$l ;;
  *) p=${p%/*}/$l ;;
  esac
done
if ! [ -f "${p%/*}/atsc" ]; then
  echo "npt: cannot find atsc beside ${p%/*}; keep atsc, srv and the programs together" >&2
  exit 127
fi
exec "${p%/*}/atsc" npt "$@"
