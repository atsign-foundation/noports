#!/bin/sh
# Runs "atsc npevents" with these arguments, using the atsc in the directory
# that holds this script once symbolic links to it are followed.
p=$0
case $p in
*/*) ;;
*)
  echo "$0: run $0 by its path, such as ./$0" >&2
  exit 127
  ;;
esac
n=0
while [ -L "$p" ]; do
  n=$((n + 1))
  if [ "$n" -gt 40 ]; then
    echo "$0: too many symbolic links" >&2
    exit 127
  fi
  l=$(readlink -- "$p")
  case $l in
  /*) p=$l ;;
  *) p=${p%/*}/$l ;;
  esac
done
exec "${p%/*}/atsc" npevents "$@"
