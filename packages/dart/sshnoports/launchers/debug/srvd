#!/bin/sh
# Runs "srvd" from the debug build of atsc: debug_atsc beside this script when
# it is installed as debug_srvd, or else the atsc beside it, once symbolic
# links to it are followed.
p=$0
case $p in
*/*) ;;
*)
  echo "$0: run $0 by its path, such as ./$0" >&2
  exit 127
  ;;
esac
n=0
while [ -L "$p" ]; do
  n=$((n + 1))
  if [ "$n" -gt 40 ]; then
    echo "$0: too many symbolic links" >&2
    exit 127
  fi
  l=$(readlink -- "$p")
  case $l in
  /*) p=$l ;;
  *) p=${p%/*}/$l ;;
  esac
done
case ${p##*/} in
debug_*) atsc=debug_atsc ;;
*) atsc=atsc ;;
esac
exec "${p%/*}/$atsc" srvd "$@"
