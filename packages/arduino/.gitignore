# PlatformIO build output
.pio/
.pioenvs/
.piolibdeps/

# IDE
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ---------------------------------------------------------------------------
# atSign key material — NEVER commit these.
# An .atKeys / atkeys.json file contains the self-encryption key alongside the
# encrypted PKAM and encryption private keys, so committing one hands over the
# device's full atSign identity. The LoadKeysFromSPIFFS example places
# atkeys.json in a PlatformIO `data/` folder for `pio run -t uploadfs`; these
# rules keep a stray `git add -A` from publishing it.
# ---------------------------------------------------------------------------
*.atKeys
atkeys.json
**/data/atkeys.json
**/data/*.atKeys
