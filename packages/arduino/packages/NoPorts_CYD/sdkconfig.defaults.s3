# ESP32-S3 sdkconfig overrides for NoPorts_CYD
# Referenced by [env:cyd2usb_s3] board_build.sdkconfig_path in platformio.ini
#
# The S3 variant (Freenove FNK0104) has 512KB SRAM + 8MB OPI PSRAM which
# gives comfortable headroom to increase the lwIP TCP PCB pool from 16→24.
# This allows the relay layer to support 6 sub-connections per session
# (ctrl=1 + subs=6×2 = 13 relay PCBs, + 5 reserved for atServer = 18 total)
# leaving a 6-PCB margin at the top.
#
# Without this change, browsers that open 6 parallel connections per origin
# saturate the 5-sub limit and stall additional requests.
CONFIG_LWIP_MAX_ACTIVE_TCP=24
# lwIP TCP buffer sizing (same rationale as sdkconfig.defaults for ESP32)
CONFIG_LWIP_TCP_WND_DEFAULT=1460
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=1460
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12
# TIME_WAIT duration: cut from 60 s to 5 s for fast PCB slot recycling.
CONFIG_LWIP_TCP_MSL=5000
# mbedTLS: dynamic buffers + reduced TLS record size to prevent AES DMA
# allocation failures under high-throughput sessions (SCP, large file transfers).
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=8192
# Full Mozilla CA bundle (~130 roots) stored in flash — zero heap cost.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
