# Dockerfile.package
# A dockerfile for packaging SSH No Ports releases using docker buildx

FROM alpine:3.22.0@sha256:8a1f59ffb675680d47db6337b49d22281a139e9d709335b492be023728e11715 AS build
WORKDIR /sshnpd
COPY . .
ARG TARGETARCH
RUN set -eux; \
  apk add clang cmake coreutils git make ninja patch python3; \
  case "${TARGETARCH}" in \
    amd64) ARCH="x64";;\
    *) ARCH=${TARGETARCH};; \
  esac; \
  cd /sshnpd/sshnpd; \
  cmake -B build -G Ninja -S . -DBUILD_SHARED_LIBS=off -DCMAKE_C_COMPILER=clang \
    -DCMAKE_C_FLAGS="-Wno-error -pthread" -DCMAKE_EXE_LINKER_FLAGS="-static"; \
  cmake --build build; \
  mkdir /tarball; \
  cd build; \
  tar -cvzf /tarball/sshnpd-linux-${ARCH}-musl.tgz sshnpd at_activate

FROM scratch
COPY --from=build /tarball/* /
