# Dockerfile.package
# A dockerfile for packaging SSH No Ports releases using docker buildx

FROM alpine:3.24.2@sha256:31b6477333eb8257db9e5d7c3a7264fd0467928756f0bbcc27d35bea5d28cdbd AS build
WORKDIR /sshnpd
COPY . .
ARG TARGETARCH
RUN set -eux; \
  apk add build-base clang cmake coreutils git make ninja python3; \
  case "${TARGETARCH}" in \
    amd64) ARCH="x64";;\
    *) ARCH=${TARGETARCH};; \
  esac; \
  cd /sshnpd/sshnpd; \
  cmake -B build -G Ninja -S . -DBUILD_SHARED_LIBS=off -DCMAKE_C_COMPILER=clang \
    -DCMAKE_C_FLAGS="-Wno-error -pthread" -DCMAKE_EXE_LINKER_FLAGS="-static"; \
  cmake --build build; \
  mkdir /tarball; \
  cd build; \
  tar -cvzf /tarball/sshnpd-linux-${ARCH}-musl.tgz sshnpd at_activate

FROM scratch
COPY --from=build /tarball/* /
