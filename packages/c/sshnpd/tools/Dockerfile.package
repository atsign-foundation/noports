# Dockerfile.package
# A dockerfile for packaging SSH No Ports releases using docker buildx

FROM atsigncompany/cbuildimage:CMake-3.31.8@sha256:079b479d10cbd505c85178e8a8b8e3e27463711eb6310d7e0c7395b49c7168db AS build
WORKDIR /sshnpd
COPY . .
RUN set -eux; \
  case "$(dpkg --print-architecture)" in \
    amd64)   ARCH="x64";;\
    arm64)   ARCH="arm64";; \
  esac; \
  cd /sshnpd/sshnpd; \
  cmake -B build -S . -DBUILD_SHARED_LIBS=off -DCMAKE_C_COMPILER=clang-18 -DCMAKE_C_FLAGS="-Wno-error -pthread"; \
  cmake --build build; \
  mkdir /tarball; \
  cd build; \
  tar -cvzf /tarball/sshnpd-linux-${ARCH}.tgz sshnpd at_activate

FROM scratch
COPY --from=build /tarball/* /
