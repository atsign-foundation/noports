<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util" >
  <!-- CI passes the real version via `wix build -d ProductVersion=x.y.z`.
       The fallback marks a build as local; it must stay below any real release. -->
  <?ifndef ProductVersion?>
    <?define ProductVersion = "0.0.1"?>
  <?endif?>
  <Package Name="NoPorts" Language="1033" Version="$(var.ProductVersion)"
           Manufacturer="Atsign" UpgradeCode="d0fde95b-ae6c-40d0-8192-82f755f32dde"
           InstallerVersion="500" Compressed="yes" Scope="perMachine" >
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <!-- Apps & Features metadata -->
    <Property Id="ARPHELPLINK" Value="https://docs.noports.com" />
    <Property Id="ARPURLINFOABOUT" Value="https://noports.com" />
    <Property Id="ARPCOMMENTS" Value="Reach this machine from anywhere without open ports." />
    <Icon Id="NoPortsIcon" SourceFile="noports.ico" />
    <Property Id="ARPPRODUCTICON" Value="NoPortsIcon" />

    <!-- Features as the user sees them on the "Custom Setup" page. Titles
         and descriptions are the only explanation they get, so say what
         each piece is for. All are on by default; Custom Setup lets an
         admin drop the service or the app on, say, a client-only box. -->
    <Feature Id="CoreTools" Title="Command-line tools" Level="1" Display="expand"
             AllowAbsent="no"
             Description="The NoPorts command-line tools (sshnp, npt, npp, srv, at_activate, noports and the daemon binary sshnpd), added to the system PATH. Required.">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
    <Feature Id="ServiceFeature" Title="Device daemon service (sshnpd)" Level="1" Display="expand"
             Description="Registers sshnpd as a Windows service so this machine can be reached over NoPorts. It is installed but not started: it needs a device atSign, keys and a list of who may connect first. NoPorts Configuration sets those up and starts it.">
      <ComponentGroupRef Id="sshnpdComponents" />
    </Feature>
    <Feature Id="ConfigAppFeature" Title="NoPorts Configuration app" Level="1" Display="expand"
             Description="Desktop app that walks you through setting up the daemon: enroll this device with NoPorts Desktop, choose who can connect, then start, stop and watch the service. Available from the Start Menu afterwards. Recommended.">
      <ComponentGroupRef Id="configAppComponents" />
    </Feature>
    <!-- Directory structure -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="NoPorts">
        <!-- The Flutter app is a directory (exe, flutter_windows.dll, data\).
             Keep it out of the way of the CLI binaries on PATH. -->
        <Directory Id="CONFIGAPPFOLDER" Name="NoPortsConfig" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="APPDATADIR" Name="NoPorts"/>
    </StandardDirectory>
    <!-- Installer UI: Welcome, License, Custom Setup (feature tree), Ready,
         Progress, Finish. Wording overrides live in noports.en-us.wxl. -->
    <WixVariable Id="WixUILicenseRtf" Value="LICENSE.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
    <ui:WixUI Id="WixUI_FeatureTree" />

    <!-- Finish page: say what state things are in and offer to open the
         configuration app. Silent installs never see this dialog. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="The NoPorts tools are installed. The device daemon service is registered but not running yet: open NoPorts Configuration to enroll this device with NoPorts Desktop, choose who may connect, and start it. You can find it in the Start Menu at any time." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open NoPorts Configuration now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- Set at run time once directories are resolved, rather than as a
         static Property, to avoid WIX1077 (property reference inside a
         property value). WixShellExec formats the value before launching. -->
    <SetProperty Id="WixShellExecTarget" Value="[CONFIGAPPFOLDER]noports_config.exe" After="CostFinalize" Sequence="both" />
    <CustomAction Id="LaunchConfigApp" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" />
    <UI>
      <!-- Only when the app feature is actually being installed (action state 3 = local). -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchConfigApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed and &amp;ConfigAppFeature = 3" />
    </UI>
  </Package>
  <!-- Core product component group -->
  <Fragment>
    <!-- Files to install -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="sshnpd" Guid="*">
        <File Id="sshnpdfile" Source="bin\sshnpd.exe" 
              Name="sshnpd.exe" KeyPath="yes" />
      </Component>
      <Component Id="sshnp" Guid="*">
        <File Id="sshnpfile" Source="bin\sshnp.exe" 
              Name="sshnp.exe" KeyPath="yes" />
      </Component>
      <Component Id="at_activate" Guid="*">
        <File Id="at_activatefile" Source="bin\at_activate.exe" 
              Name="at_activate.exe" KeyPath="yes" />
      </Component>
      <Component Id="noports" Guid="*">
        <File Id="noportsfile" Source="bin\noports.exe" 
              Name="noports.exe" KeyPath="yes" />
      </Component>
      <Component Id="npp" Guid="*">
        <File Id="nppfile" Source="bin\npp.exe" 
              Name="npp.exe" KeyPath="yes" />
      </Component>
      <Component Id="npp_atserver" Guid="*">
        <File Id="npp_atserverfile" Source="bin\npp_atserver.exe" 
              Name="npp_atserver.exe" KeyPath="yes" />
      </Component>
      <Component Id="npp_file" Guid="*">
        <File Id="npp_files" Source="bin\npp_file.exe" 
              Name="npp_file.exe" KeyPath="yes" />
      </Component>
      <Component Id="npt" Guid="*">
        <File Id="nptfile" Source="bin\npt.exe" 
              Name="npt.exe" KeyPath="yes" />
      </Component>
      <Component Id="srv" Guid="*">
        <File Id="srvfile" Source="bin\srv.exe" 
              Name="srv.exe" KeyPath="yes" />
      </Component>
      <Component Id="sshnpd_config" Guid="2812ad14-207e-4ab1-983b-92a65eb201a2" Directory="APPDATADIR" Permanent="yes" NeverOverwrite="yes">
        <File Id="sshnpd_configfile" Source="bin\sshnpd.yaml" 
              Name="sshnpd.yaml" KeyPath="yes" />
      </Component>
      <!-- Environment PATH -->
      <Component Id="UpdatePath" Guid="d7a87a7f-1bcc-4eba-b089-6c2ab0e0f0bd">
        <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" 
                     Permanent="no" Part="last" Action="set" System="yes" />
      </Component>
      <Component Id="CertUpdaterScript" Guid="*">
        <File Id="certupdaterfile" Source="certupdater.ps1" Name="certupdater.ps1" />
      </Component>
    </ComponentGroup>
  </Fragment>
  <!-- Configuration app component group -->
  <Fragment>
    <ComponentGroup Id="configAppComponents">
      <!-- Everything `flutter build windows` put in the Release folder. CI
           copies it to bin\noports_config before building the MSI. -->
      <Files Include="bin\noports_config\**" Directory="CONFIGAPPFOLDER" />
      <Component Id="configAppShortcut" Directory="ProgramMenuFolder" Guid="7c1d0a52-6b7e-4f0e-9b57-3c2f9d6a1e21">
        <Shortcut Id="configAppStartMenuShortcut"
                  Name="NoPorts Configuration"
                  Description="Configure the NoPorts daemon and control its service"
                  Target="[CONFIGAPPFOLDER]noports_config.exe"
                  WorkingDirectory="CONFIGAPPFOLDER"
                  Icon="NoPortsIcon" />
        <RegistryValue Root="HKCU" Key="Software\Atsign\NoPorts" Name="ConfigAppShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
  <!-- Sshnpd service component group -->
  <Fragment>
    <Property Id="SERVICE_NAME" Value="sshnpd" />
    <Property Id="SERVICE_DISPLAYNAME" Value="NoPorts Daemon" />
    <Property Id="SERVICE_DESCRIPTION" Value="NoPorts Daemon Service (sshnpd)" />
    <ComponentGroup Id="sshnpdComponents" Directory="INSTALLFOLDER">
      <Component Id="sshnpdServiceComponent" Guid="*">
        <File Id="sshnpdServiceExeFile" Source="bin\sshnpdService.exe" 
              Name="sshnpdService.exe" KeyPath="yes" />
        <ServiceInstall Id="sshnpdServiceInstaller"
                        Type="ownProcess"
                        Name="[SERVICE_NAME]"
                        DisplayName="[SERVICE_DISPLAYNAME]"
                        Description="[SERVICE_DESCRIPTION]"
                        Start="auto"
                        ErrorControl="normal"
                        Vital="yes"
                        Account="LocalSystem"/>
        <!-- Deliberately not started on a fresh install: the daemon has no atsign or
             keys configured yet, so it would start and immediately exit. See the
             sshnpdServiceUpgradeStart component for the upgrade case. -->
        <ServiceControl Id="sshnpdServiceStart"
                        Name="[SERVICE_NAME]"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
        <util:EventSource Name="[SERVICE_DISPLAYNAME]"
                          Log="Application"
                          EventMessageFile="[#sshnpdServiceExeFile]"/>
      </Component>
      <!-- A major upgrade uninstalls the old product, which stops and removes the
           service. Without this the new service is registered for auto-start but stays
           stopped until the next reboot. Only fires when upgrading an existing install. -->
      <Component Id="sshnpdServiceUpgradeStart"
                 Guid="1ecb19e0-5ceb-4cf9-aa6b-5532154c2b9c"
                 Condition="WIX_UPGRADE_DETECTED">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Atsign\NoPorts"
                       Name="ServiceStartedByUpgrade" Type="integer" Value="1" KeyPath="yes" />
        <!-- Wait="no" so a daemon that fails to come up cannot fail the upgrade. -->
        <ServiceControl Id="sshnpdServiceUpgradeStartControl"
                        Name="[SERVICE_NAME]"
                        Start="install"
                        Wait="no" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>