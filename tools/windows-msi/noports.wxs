<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="NoPorts" Language="1033" Version="1.0.0.0" 
           Manufacturer="NoPorts" UpgradeCode="d0fde95b-ae6c-40d0-8192-82f755f32dde"
           InstallerVersion="500" Compressed="yes" Scope="perMachine" >
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" /> 

      <!-- Main Feature - Core Tools (always installed) -->
    <Feature Id="CoreTools" Title="NoPorts Core Tools" Level="1" 
            Description="Core NoPorts command-line tools">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- Optional Feature - Service (default off) -->
    <Feature Id="ServiceFeature" Title="NoPorts Service" Level="2" 
            Description="Install NoPorts as a Windows service (sshnpd)">
      <ComponentGroupRef Id="sshnpdComponents" />
    </Feature>

    <!-- Directory structure -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="NoPorts">
      </Directory>
    </StandardDirectory>
    
    <!-- Files to install -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="sshnpd">
        <File Id="sshnpdfile" Source="bin\sshnpd.exe" 
              Name="sshnpd.exe" />
      </Component>

      <Component Id="sshnp">
        <File Id="sshnpfile" Source="bin\sshnp.exe" 
              Name="sshnp.exe" />
      </Component> 

      <Component Id="at_activate">
        <File Id="at_activatefile" Source="bin\at_activate.exe" 
              Name="at_activate.exe" />
      </Component>

      <Component Id="np_admin">
        <File Id="np_adminfile" Source="bin\np_admin.exe" 
              Name="np_admin.exe" />
      </Component>

      <Component Id="npa_file">
        <File Id="npa_files" Source="bin\npa_file.exe" 
              Name="npa_file.exe" />
      </Component>

      <Component Id="npp_atserver">
        <File Id="npp_atserverfile" Source="bin\npp_atserver.exe" 
              Name="npp_atserver.exe" />
      </Component>

      <Component Id="npp_file">
        <File Id="npp_files" Source="bin\npp_file.exe" 
              Name="npp_file.exe" />
      </Component>

      <Component Id="npt">
        <File Id="nptfile" Source="bin\npt.exe" 
              Name="npt.exe" />
      </Component>

      <Component Id="srv">
        <File Id="srvfile" Source="bin\srv.exe" 
              Name="srv.exe" />
      </Component>

      <!-- Environment PATH -->
      <Component Id="UpdatePath" Guid="d7a87a7f-1bcc-4eba-b089-6c2ab0e0f0bd">
        <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" 
                     Permanent="no" Part="last" Action="set" System="no" />
      </Component>
    </ComponentGroup>

    <!-- sshnpd Service installation -->

    <!-- Properties to store user input with default values -->
    <Property Id="SERVICE_NAME" Value="sshnpd" />
    <Property Id="SERVICE_DISPLAYNAME" Value="NoPorts daemon" />
    <Property Id="SERVICE_DESCRIPTION" Value="NoPorts daemon service" />

    <ComponentGroup Id="sshnpdComponents" Directory="INSTALLFOLDER">
      <Component Id="NoPortsServiceComponent" Guid="4a632555-ba94-42f4-806b-389ba1752cda">
      <File Id="NoPortsServiceExeFile" Source="bin\sshnpdService.exe" 
              Name="sshnpdService.exe" KeyPath="yes" />
        <ServiceInstall Id="NoPortsServiceInstaller"
                             Type="ownProcess"
                             Name="[SERVICE_NAME]"
                             DisplayName="[SERVICE_DISPLAYNAME]"
                             Description="[SERVICE_DESCRIPTION]"
                             Start="auto"
                             ErrorControl="normal"
                             Vital="yes"
                             Account="NT AUTHORITY\LocalService"/> 
        <ServiceControl Id="StartNoPortsService"
                             Name="[SERVICE_NAME]"
                             Start="install"
                             Stop="both"
                             Remove="uninstall"
                             Wait="yes" />

        <util:ServiceConfig ServiceName="[SERVICE_NAME]"
                            FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="60"
                            ResetPeriodInDays="1" />

      </Component>
    </ComponentGroup>
    <WixVariable Id="WixUILicenseRtf" Value="LICENSE.rtf" />
    <ui:WixUI Id="WixUI_FeatureTree" />    
  </Package>
</Wix>